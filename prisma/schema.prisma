generator client {
  provider      = "prisma-client-js"
  output        = "./generated-client-v2"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String       @unique
  password    String
  address     String?
  originStory OriginStory?
  marketGap   MarketGap?
  tribe       TribalIdentity?
  mechanism   UniqueMechanism?
  usp         USPStatement?
  summary     MessagingSummary?
  courses     GeneratedCourse[]
  brandBoards BrandBoard[]
  tokenUsage  TokenUsage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model OriginStory {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  answers        String   // JSON stringified array
  generatedStory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MarketGap {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  answers         String   // JSON stringified array
  generatedReport String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TribalIdentity {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  answers         String   // JSON stringified array
  generatedReport String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UniqueMechanism {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  answers         String   // JSON stringified array
  generatedReport String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model USPStatement {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  answers         String   // JSON stringified array
  generatedReport String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MessagingSummary {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  answers         String   // JSON stringified array
  generatedReport String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GeneratedCourse {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  description     String
  pricingTier     String
  tone            String
  moduleCount     Int
  content         String   // JSON string containing intro, modules, lessons, quizzes, and conclusion
  thumbnailUrl    String?  // AI-generated course thumbnail URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrandBoard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  feel          String   // Selection: Elite, Minimalist, Bold, etc.
  persona       String   // Selection: Visionary, Sage, Ruler, etc.
  demographics  String   // Selection: HNWIs, Gen Z Creatives, etc.
  colors        String   // JSON stringified selection of color hexes/names
  typography    String   // Selection: Bold Serif, Clean Sans, Elegant Cursive
  visualContent String   // JSON string containing generated palette and design elements
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TokenUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  endpoint         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  model            String
  createdAt        DateTime @default(now())
}
